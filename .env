PORT=3000
# Make.com "Custom webhook" adresiniz (gizli tutun, istemci koduna koymayın)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/BURAYA_KENDI_WEBHOOK_ADRESINIZ
# Make.com HTTP modülünün x-api-key başlığında göndereceği uzun rastgele anahtar
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVE_API_KEY=BURAYA_UZUN_RASTGELE_BIR_ANAHTAR
# Sitenizin adresi (CORS). Örn: https://lesbos.example.com
ALLOWED_ORIGIN=https://lesbos.example.com
